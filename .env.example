# ==============================================================================
# RevCount - AI-Powered Financial Reporting Assistant Configuration
# ==============================================================================

# Application & Environment
APP_NAME=RevCount
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# LLM Configuration (Google Gemini)
# Leave empty to use verified deterministic local RAG demo mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
MAX_LLM_CONCURRENCY=5
LLM_TIMEOUT_SECONDS=15

# Database Configuration
# PostgreSQL connection string: postgresql+psycopg2://user:password@localhost:5432/revcount
# Leave empty or set to sqlite:///./revcount.db for seamless local execution
DATABASE_URL=sqlite:///./revcount.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Cache Configuration (Redis)
# Redis URL: redis://localhost:6379/0
# If Redis is unavailable, RevCount automatically falls back to high-performance in-memory cache
REDIS_URL=redis://localhost:6379/0
EXACT_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_SIMILARITY_THRESHOLD=0.80

# Document Ingestion & Storage
UPLOAD_DIR=./data/documents
SAMPLE_DIR=./data/sample
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Results-Day Mode
RESULTS_DAY_WARM_BATCH_SIZE=5
